:root{
  --bg:#f6f7fb;
  --card:#ffffff;
  --accent:#2b63ff;
  --muted:#6b7280;
  --glass: rgba(255,255,255,0.75);
  --radius:12px;
  --max:1100px;
  --pad:18px;
  font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  color: #111827;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  line-height:1.5;
  padding-bottom:48px;
}

.container{max-width:var(--max);margin:0 auto;padding:0 18px;}

.site-header{background:linear-gradient(90deg,#fff 0%, #f8fbff 100%);border-bottom:1px solid #e6e9ef;position:sticky;top:0;z-index:40}
.header-inner{display:flex;align-items:center;justify-content:space-between;padding:14px 0;}
.brand h1{margin:0;font-size:20px;letter-spacing:0.2px;}
.brand .tag{margin:2px 0 0;color:var(--muted);font-size:13px}

.nav a{margin-left:16px;color:var(--muted);text-decoration:none;font-weight:600;font-size:14px}
.nav a.btn-outline{padding:8px 12px;border-radius:8px;border:1px solid #dbe5ff;color:var(--accent);background:#fff}

.hero{padding:36px 0}
.hero-grid{display:grid;grid-template-columns:1fr 300px;gap:20px;align-items:center}
.lead{color:var(--muted);font-size:16px;margin-top:8px}
.cta-row{margin-top:16px}
.btn-primary, .btn-ghost{
  display:inline-block;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700;border:0;cursor:pointer;
}
.btn-primary{background:var(--accent);color:#fff}
.btn-ghost{background:transparent;border:1px solid #dbe7ff;color:var(--accent)}

.quick-info{list-style:none;padding:0;margin:14px 0 0;color:var(--muted);font-size:14px}
.quick-info li{margin-bottom:6px}

.profile-card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(16,24,40,0.06);text-align:center}
.profile-avatar{width:72px;height:72px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#6b8bff);display:inline-flex;align-items:center;justify-content:center;color:#fff;font-weight:800;margin-bottom:10px}
.profile-links a{margin:6px;color:var(--accent);display:inline-block;text-decoration:none}

.section{padding:36px 0}
.section.alt{background:linear-gradient(180deg,#fbfdff, #ffffff);border-top:1px solid #eef2ff}

.section-title{font-size:20px;color:#0f172a;margin:0 0 6px}
.section-sub{color:var(--muted);margin-top:6px;margin-bottom:18px}

.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(16,24,40,0.04)}
.card h3{margin:0 0 8px}
.card-meta{display:flex;justify-content:space-between;align-items:center;color:var(--muted);margin-top:12px}
.card-meta a{color:var(--accent);text-decoration:none;font-weight:700}

.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.skill{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 4px 12px rgba(16,24,40,0.04)}
.skill h4{margin:0 0 8px}

.about-list{margin-top:12px;color:var(--muted)}

.contact-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.contact-form label{display:block}
.contact-form input, .contact-form textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6e9ef;background:#fff}
.contact-form span{display:block;font-weight:700;margin-bottom:6px}

.form-actions{grid-column:1/-1;display:flex;gap:10px;margin-top:8px}
.form-result{margin-top:12px;color:var(--muted)}

.site-footer{margin-top:28px;padding:18px 0;text-align:center;color:var(--muted);font-size:14px}

@media (max-width:880px){
  .hero-grid{grid-template-columns:1fr; text-align:center}
  .contact-form{grid-template-columns:1fr}
  .nav{display:none}
}
